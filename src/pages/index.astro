---
import '../styles/global.css';
import StandardLayout from '../layouts/Standard.astro';

const posts = Object.values(import.meta.glob("./posts/*.md", { eager: true }));
---
<StandardLayout title="the garage">
  <p>Hi I'm Alan, welcome to my webpage. I'm a Software Developer currently working as a DevOps engineer, but looking to pivot to systems engineering.</p>
  <hr>
  <h1>Archive</h1>
  <ul>
    {
      posts.map((post: any) => (
        <li>
	  <a href={post.url}>{post.frontmatter.title}</a>
	</li>
      ))
    }
  </ul>
</StandardLayout>

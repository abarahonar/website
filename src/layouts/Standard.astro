---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Head from '../components/Head.astro';

const { title } = Astro.props;
---
<!doctype html>
<html lang="en-US">
  <Head title={title} />
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
